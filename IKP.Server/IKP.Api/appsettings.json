{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Diagnostics": {
    "Statistics": {
      "Worker": {
        "BatchSize": 32,
        "PollIntervalMilliseconds": 1000,
        "StaleAfterMinutes": 10,
        "InitialRetryDelaySeconds": 5,
        "MaximumRetryDelaySeconds": 300
      }
    },
    "Criticality": {
      "Worker": {
        "BatchSize": 32,
        "PollIntervalMilliseconds": 1000,
        "StaleAfterMinutes": 10,
        "InitialRetryDelaySeconds": 5,
        "MaximumRetryDelaySeconds": 300
      }
    }
  },
  "Files": {
    "Storage": {
      "RootPath": "/srv/storage",
      "MaximumFileSizeBytes": 5368709120,
      "UploadSessionLifetimeMinutes": 120,
      "ProviderCode": "LOCAL",
      "CopyBufferSizeBytes": 1048576
    }
  },
  "Redis": {
    "ConnectionString": "192.168.0.10:6379,abortConnect=false"
  },
  "Authentication": {
    "Issuer": "IKP.Server",
    "Audience": "IKP.Client",
    "AccessTokenMinutes": 10,
    "RefreshTokenDays": 30,
    "MaximumFailedLoginAttempts": 5,
    "LockoutMinutes": 15,
    "MinimumPasswordLength": 12
  },
  "Email": {
    "Enabled": false,
    "Host": "",
    "Port": 587,
    "EnableSsl": true,
    "FromAddress": "",
    "FromDisplayName": "IKP Server",
    "UserName": "",
    "Password": ""
  }
}
